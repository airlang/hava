## Variables, arrays and dictionaries ##

name = "Hava":
version = 2:

yaz(name):
yaz(version):
yaz(tür(name)):
yaz(tür(version)):

version = version + 1:
yaz(version):

array = ["h","e","l","l","o"]:
yaz(array):
array[0] = "y":
yaz(array):
ekle(array, "w"):
yaz(array):
çıkar(array, 0):
yaz(array):
yaz(tür(array)):

user = {
    "address" => {
        "city" => "Ankara"
    }
}:
yaz(user["address"]["city"]):
user["address"]["city"] = "İstanbul":
yaz(user["address"]["city"]):